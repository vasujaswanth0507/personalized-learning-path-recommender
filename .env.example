# Google Gemini API Settings (Optional)
# If provided, LearnPath uses Google Gemini for contextual mentor conversations.
# If omitted, LearnPath falls back gracefully to its intent-aware local heuristics.
GEMINI_API_KEY=

# Configurable Gemini Model (Optional)
# Defaults to gemini-1.5-flash
GEMINI_MODEL=gemini-1.5-flash

# SQLite Database Settings (Optional)
# Defaults to backend/app/learnpath.db
DATABASE_PATH=
