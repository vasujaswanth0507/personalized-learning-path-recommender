# LearnPath AI Environment Configuration

# Primary LLM Provider: Google Gemini
# If not provided, LearnPath AI automatically activates its rich deterministic pedagogical fallback engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# SQLite Database Location (defaults to learnpath.db in the backend folder)
DATABASE_PATH=learnpath.db

# App Settings
APP_ENV=development
